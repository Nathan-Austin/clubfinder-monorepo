# spotify_service environment
# Copy to .env. Loaded by python-dotenv when the systemd units start.

# Browser automation
CHROME_PATH=/usr/bin/chromium-browser
CHROMEDRIVER_PATH=/usr/bin/chromedriver
CHROME_DRIVER_PATH=/usr/bin/chromedriver
CHROME_LOG_FILE=chrome.log
CHROMIUM_FLAGS=
HEADLESS=true
PYTHONUNBUFFERED=1

# Spotify for Developers account that owns the apps
SPOTIFY_EMAIL=you@example.com
SPOTIFY_PASSWORD=your-spotify-password
MAX_USERS_PER_APP=25
CAPTCHA_API_KEY=your-captcha-api-key

# PostgreSQL
DB_HOST=localhost
DB_NAME=your-database-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DATABASE_URL=postgres://your-db-user:your-db-password@localhost:5432/your-database-name

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Email notifications
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_SERVER=mail.example.com
# IMAP port (code default 993) and SMTP port (code default 587)
EMAIL_PORT=993
SMTP_PORT=587
