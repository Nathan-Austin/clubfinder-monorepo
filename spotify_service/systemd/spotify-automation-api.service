[Unit]
Description=Spotify Automation Flask API
After=network.target redis.service

[Service]
Type=simple
User=nathan
WorkingDirectory=/home/nathan/clubfinder/spotify_service
Environment="PATH=/home/nathan/spotify_service_env/bin"
# Using python directly for simplicity, can use gunicorn later
ExecStart=/home/nathan/spotify_service_env/bin/python -m src.spotify_automation.api.app
Restart=always

[Install]
WantedBy=multi-user.target
