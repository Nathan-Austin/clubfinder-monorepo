[Unit]
Description=Spotify Automation Celery Worker (Browser Queue)
After=network.target redis.service

[Service]
Type=simple
User=nathan
WorkingDirectory=/home/nathan/clubfinder-monorepo/spotify_service
Environment="PATH=/home/nathan/spotify_service_env/bin"
# Explicitly loading .env file if needed, though python-dotenv in code handles it
ExecStart=/home/nathan/spotify_service_env/bin/celery -A src.spotify_automation.celery:app worker --loglevel=info -Q spotify_browser --concurrency=1
Restart=always

[Install]
WantedBy=multi-user.target
