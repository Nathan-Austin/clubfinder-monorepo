{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"outDir": "../dist-scripts",
		"rootDir": "..",
		"sourceMap": true,
		"allowJs": true,
		"resolveJsonModule": true
	},
	"include": ["*.ts"]
}
