{
	"name": "clubfindr",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
	"engines": {
		"node": "^24.0.0",
		"pnpm": "^10.0.0"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"prepare": "svelte-kit sync || echo ''",
		"build": "vite build",
		"preview": "vite preview --port 3000",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"start": "node build/index.js",
		"build-scripts": "tsc -p scripts/tsconfig.json",
		"genre-maintenance": "pnpm build-scripts && node dist-scripts/scripts/genre-maintenance.js",
		"convert-genres": "pnpm build-scripts && node dist-scripts/scripts/convert-clusters-to-unified.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcryptjs": "^2.4.6",
		"@types/google.maps": "^3.55.12",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/lodash": "^4.17.13",
		"@types/node": "^24.19.0",
		"@types/nodemailer": "^6.4.15",
		"@types/pg": "^8.11.6",
		"@types/qrcode": "^1.5.5",
		"@types/uuid": "^10.0.0",
		"date-picker-svelte": "^2.17.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@googlemaps/js-api-loader": "^1.16.8",
		"@types/pdfkit": "^0.13.9",
		"bcryptjs": "^2.4.3",
		"chart.js": "^4.4.4",
		"csv-parse": "^5.6.0",
		"dotenv": "^16.4.5",
		"geolib": "^3.3.4",
		"jsonwebtoken": "^9.0.2",
		"lodash": "^4.17.21",
		"lucide-svelte": "^0.454.0",
		"nodemailer": "^6.9.14",
		"pdfkit": "^0.17.0",
		"pg": "^8.12.0",
		"qrcode": "^1.5.4",
		"uuid": "^10.0.0"
	},
	"type": "module",
	"browser-extension": {
		"permissions": [
			"geolocation"
		]
	}
}
