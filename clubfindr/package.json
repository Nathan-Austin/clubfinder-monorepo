		"@types/nodemailer": "^6.4.15",
		"@types/pg": "^8.11.6",
		"@types/qrcode": "^1.5.5",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^8.2.0",
		"@typescript-eslint/parser": "^8.2.0",
		"autoprefixer": "^10.4.20",
		"aws-sdk": "^2.1692.0",
		"date-picker-svelte": "^2.13.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^8.10.0",
		"eslint-plugin-svelte": "^2.43.0",
		"export": "0.1.337",
		"inquirer": "^10.1.8",
		"mock-aws-s3": "^4.0.2",
		"nock": "^13.5.5",
		"postcss": "^8.4.41",
		"prettier": "^2.8.8",
