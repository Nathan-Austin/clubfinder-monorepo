# clubfindr (SvelteKit) environment
# Copy to .env and fill in. Most values are read via $env/static/*, so they are
# baked in at `pnpm build` time: rebuild after changing them. At runtime PM2
# (ecosystem.config.cjs) also loads this file and sets NODE_ENV/PORT.

# PostgreSQL
VITE_PG_HOST=localhost
VITE_PG_PORT=5432
VITE_PG_DB=your-database-name
VITE_PG_USERNAME=your-db-user
VITE_PG_PASSWORD=your-db-password
DATABASE_URL=postgres://your-db-user:your-db-password@localhost:5432/your-database-name

# Auth / crypto
JWT_SECRET=your-jwt-secret
VITE_CRYPTO_KEY=your-crypto-key

# Spotify
PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
VITE_SPOTIFY_REDIRECT_USER_URI=https://your-domain/your-user-callback-path
VITE_SPOTIFY_REDIRECT_BAR_URI=https://your-domain/your-bar-callback-path
NEW_SPOTIPY_CLIENT_ID=your-spotify-client-id
NEW_SPOTIPY_CLIENT_SECRET=your-spotify-client-secret
# spotify_service Flask API (systemd: spotify-automation-api, port 5000)
SPOTIFY_SERVICE_URL=http://localhost:5000

# SoundCloud
SC_API_KEY=your-soundcloud-api-key
VITE_SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
VITE_SOUNDCLOUD_CLIENT_SECRET=your-soundcloud-client-secret

# Tidal
VITE_TIDAL_CLIENT_ID=your-tidal-client-id
VITE_TIDAL_CLIENT_SECRET=your-tidal-client-secret

# Google (Maps/geocoding, OAuth login)
VITE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Facebook login
VITE_FACEBOOK_APP_ID=your-facebook-app-id
VITE_FACEBOOK_APP_SECRET=your-facebook-app-secret

# reCAPTCHA
VITE_reCAPTCHA_SITE_KEY=your-recaptcha-site-key
VITE_reCAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email
GMAIL_USER=you@example.com
GMAIL_PASS=your-gmail-app-password
SPACEMAIL_USER=you@example.com
SPACEMAIL_PASSWORD=your-spacemail-password

# AI providers
OPEN_AI_API=your-openai-api-key
GROK_API_KEY=your-grok-api-key
