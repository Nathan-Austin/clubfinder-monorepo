# clubfindr (SvelteKit) environment
# Copy to .env and fill in. Every value is read via $env/static/* (PUBLIC_* is shipped
# to the browser, everything else stays on the server), so they are baked in at
# `pnpm build` time: rebuild after changing them. Every key must be present. At runtime PM2
# (ecosystem.config.cjs) also loads this file and sets NODE_ENV/PORT.

# Public origin of the site as the browser sees it (adapter-node reads it at runtime).
# Required in production for the CSRF origin check and for absolute URLs; leave unset locally.
# ORIGIN=https://www.clubfindr.com

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=your-database-name
PG_USERNAME=your-db-user
PG_PASSWORD=your-db-password
DATABASE_URL=postgres://your-db-user:your-db-password@localhost:5432/your-database-name

# Auth / crypto
JWT_SECRET=your-jwt-secret
CRYPTO_KEY=your-crypto-key

# Spotify
PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
PUBLIC_SPOTIFY_REDIRECT_USER_URI=https://your-domain/your-user-callback-path
PUBLIC_SPOTIFY_REDIRECT_BAR_URI=https://your-domain/your-bar-callback-path
NEW_SPOTIPY_CLIENT_ID=your-spotify-client-id
NEW_SPOTIPY_CLIENT_SECRET=your-spotify-client-secret
# spotify_service Flask API (systemd: spotify-automation-api, port 5000)
SPOTIFY_SERVICE_URL=http://localhost:5000

# SoundCloud
SC_API_KEY=your-soundcloud-api-key
SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
SOUNDCLOUD_CLIENT_SECRET=your-soundcloud-client-secret

# Tidal
TIDAL_CLIENT_ID=your-tidal-client-id
TIDAL_CLIENT_SECRET=your-tidal-client-secret

# Google (Maps/geocoding, OAuth login)
PUBLIC_MAPS_API_KEY=your-google-maps-api-key
PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Facebook login
PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# reCAPTCHA
PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email
GMAIL_USER=you@example.com
GMAIL_PASS=your-gmail-app-password
SPACEMAIL_USER=you@example.com
SPACEMAIL_PASSWORD=your-spacemail-password

# AI providers
OPEN_AI_API=your-openai-api-key
GROK_API_KEY=your-grok-api-key
