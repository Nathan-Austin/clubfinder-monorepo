# barfindr environment
# Copy to .env. Loaded by the barfindr systemd units (EnvironmentFile=) and by
# python-dotenv. DATABASE_URL is required; startup fails without it.

DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/clubfindr
REDIS_URL=redis://localhost:6379/0
# Key used to encrypt stored Spotify credentials
ENCRYPTION_KEY=your-encryption-key
# SPOTIFY_REDIRECT_URI is no longer read: the playback polling was retired on 2026-11-12
