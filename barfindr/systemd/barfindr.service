cat > /clubfinder/barfindr/systemd/barfindr.service << 'EOF'
[Unit]
Description=BarFindr Service
After=network.target postgresql.service redis.service

[Service]
User=nathan
WorkingDirectory=/home/nathan/clubfinder/barfindr
Environment="PYTHONPATH=/home/nathan/clubfinder/barfindr/src"
EnvironmentFile=/home/nathan/clubfinder/barfindr/.env
ExecStart=/usr/bin/python3 -m src.barfindr.main
Restart=always

[Install]
WantedBy=multi-user.target
EOF