cat > /clubfinder/barfindr/systemd/barfindr-celery-beat.service << 'EOF'
[Unit]
Description=BarFindr Celery Beat
After=network.target postgresql.service redis.service

[Service]
User=nathan
WorkingDirectory=/home/nathan/clubfinder/barfindr
Environment="PYTHONPATH=/home/nathan/clubfinder/barfindr/src"
EnvironmentFile=/home/nathan/clubfinder/barfindr/.env
ExecStart=/usr/bin/celery -A src.barfindr.celery:app beat --loglevel=info
Restart=always

[Install]
WantedBy=multi-user.target
EOF