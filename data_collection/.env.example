# data_collection environment
# Copy to .env.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=your-database-name
PG_USERNAME=your-db-user
PG_PASSWORD=your-db-password
DATABASE_URL=postgres://your-db-user:your-db-password@localhost:5432/your-database-name

# Spotify
NEW_SPOTIPY_CLIENT_ID=your-spotify-client-id
NEW_SPOTIPY_CLIENT_SECRET=your-spotify-client-secret
# JSON list of client credentials, rotated by spotipy_search.py
SPOTIFY_CREDENTIALS=[{"client_id":"your-spotify-client-id","client_secret":"your-spotify-client-secret"}]
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback
USERNAME=your-spotify-username
SCOPE=your-spotify-scopes

# SoundCloud
SC_API_KEY=your-soundcloud-api-key
SC_CLIENT_ID=your-soundcloud-client-id
SC_CLIENT_SECRET=your-soundcloud-client-secret
redirect_url=https://your-domain/your-callback-path

# Google Maps / other APIs
MAPS_API_KEY=your-google-maps-api-key
API_KEY=your-api-key

# Facebook
FB_APP_ID=your-facebook-app-id
FB_SECRET=your-facebook-app-secret

# Optional tuning (defaults are set in code)
# DATA_COLLECTION_START_CITY=
# DATA_COLLECTION_RESUME=
# EVENT_FETCHER_TIMEOUT=
# SPOTIFY_TIMEOUT=
# SOUNDCLOUD_TIMEOUT=
# SPOTIFY_REQUESTS_PER_KEY=
# SPOTIFY_MIN_REQUEST_INTERVAL=
# SPOTIFY_API_CALL_COOLDOWN_DAYS=
# DB_POOL_DISABLE=
# DB_POOL_MINCONN=
# DB_POOL_MAXCONN=
# CLUBFINDER_LOG_PII=
