{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/*"
      ],
      "src/*": [
        "src/*"
      ],
      "assets/*": [
        "assets/*"
      ]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-native",
    "importHelpers": false,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "**/*.ts",
    "**/*.tsx",
    "*.js",
    "*.jsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}