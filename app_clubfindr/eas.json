{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "release": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EAS_BUILD_RUNNER": "eas-build-worker-ubuntu-22.04-medium",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "cache": {
        "key": "pnpm-v1"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EAS_BUILD_RUNNER": "eas-build-worker-ubuntu-22.04-medium",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "cache": {
        "key": "pnpm-v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

